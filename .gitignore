# Development documentation is shared for co-development.
# Do not commit secrets or private user content to Markdown files.

# Local agent/runtime artifacts (Markdown instructions/reports are shared).
/.pi/*
!/.pi/
!/.pi/**/
!/.pi/**/*.md
/subagent-artifacts/*
!/subagent-artifacts/
!/subagent-artifacts/**/
!/subagent-artifacts/**/*.md

# Release artifacts (release manifests/checksums are shared; binaries stay local).
/release-artifacts/*
!/release-artifacts/
!/release-artifacts/**/
!/release-artifacts/**/*.md
!/release-artifacts/**/*SHA256SUMS.txt
*.apk
*.aab
*.apks
*.idsig

# Android signing / local config
/android/key.properties
/android/local.properties
/android/*.jks
/android/*.keystore
/android/app/debug
/android/app/profile
/android/app/release

# Flutter/Dart/Pub
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# IDE / OS
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store

# Secrets / logs
.env
.env.*
*.pem
*.p12
*.log
*_log.txt
*_crash_log.txt
/logs/
